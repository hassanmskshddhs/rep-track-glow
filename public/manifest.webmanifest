{
  "id": "/",
  "name": "IronLog",
  "short_name": "IronLog",
  "description": "Track. Lift. Repeat. Your personal gym progression tracker.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["health", "fitness", "lifestyle"],
  "iarc_rating_id": "",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Start Workout",
      "short_name": "Workout",
      "description": "Jump straight into your next training session",
      "url": "/workout",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    },
    {
      "name": "Log Calories",
      "short_name": "Log",
      "description": "Quickly log your meals and calories",
      "url": "/nutrition",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
      ]
    }
  ],
  "share_target": {
    "action": "/share-receiver",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "IronLog Status",
      "short_name": "Status",
      "description": "Track your daily gym progress and sets",
      "tag": "ironlog-status",
      "ms_ac_template": "/widgets/status-template.json",
      "data": "/widgets/status-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.jpg",
          "sizes": "512x1024",
          "label": "IronLog daily status widget"
        }
      ],
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ],
      "backgrounds": [
        { "src": "/widget-worker", "type": "text/html" }
      ],
      "auth": false,
      "update": 900
    }
  ],
  "note_taking": {
    "new_note_url": "/nutrition"
  },
  "screenshots": [
    {
      "src": "/screenshot-mobile.jpg",
      "sizes": "512x1024",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "IronLog active workout session on mobile"
    },
    {
      "src": "/screenshot-desktop.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "IronLog progress dashboard on desktop"
    }
  ]
}
